{
  "seed": 42,
  "device": "auto",

  "dataset": {
    "name": "FER2013",
    "num_classes": 7,
    "classes": ["angry", "disgust", "fear", "happy", "sad", "surprise", "neutral"],

    "paths": {
      "train_root": "data/DataSets/train",
      "test_root": "data/DataSets/test"
    },

    "split": {
      "method": "stratified",
      "train": 0.7,
      "val": 0.15,
      "test": 0.15
    }
  },

  "transforms": {
    "img_size": 48,
    "normalize": { "mean": [0.5], "std": [0.5] },

    "train": {
      "resize": true,
      "augmentation": {
        "horizontal_flip": true,
        "rotation_deg": 15,
        "random_resized_crop_scale": [0.8, 1.0]
      }
    },

    "val_test": {
      "resize": true,
      "augmentation": null
    }
  },

  "training": {
    "epochs": 30,
    "batch_size": 64,
    "num_workers": 2,

    "optimizer": "adam",
    "learning_rate": 0.001,
    "weight_decay": 0.0,

    "loss": {
      "type": "cross_entropy",
      "class_weights": "inverse_frequency"
    },

    "early_stopping": {
      "enabled": true,
      "monitor": "val_loss",
      "mode": "min",
      "patience": 5,
      "min_delta": 0.0,
      "target": {
        "enabled": false,
        "metric": "val_accuracy",
        "value": 0.98
      }
    },

    "checkpoint": {
      "save_best": true,
      "save_last": true,
      "dir": "models",
      "best_name": "best_model.pth",
      "last_name": "last_model.pth",
      "resume": {
        "enabled": false,
        "path": "models/last_model.pth"
      }
    }
  },

  "model": {
    "name": "cnn_simple",
    "finetune": false
  },

  "logging": {
    "tensorboard": {
      "enabled": true,
      "log_dir": "runs"
    }
  }
}
